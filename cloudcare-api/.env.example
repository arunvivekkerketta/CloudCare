# ---------------------------------------------------------------------------
# CloudCare API — environment template. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# development | production  (production enforces: real SECRET_KEY, Postgres,
# no /docs, no SQLite)
ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-me

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# "Keep me signed in on this device" lifetime (7 days).
REMEMBER_ME_EXPIRE_MINUTES=10080

# Comma-separated list of allowed browser origins. NEVER use "*".
# Local dev example below; set to your Netlify URL in production, e.g.
# CORS_ORIGINS=https://cloudcare.netlify.app
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Login / register rate limits (slowapi syntax). Leave the defaults in
# production; setting either to an empty string disables that limiter.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=20/hour

# -------------------------------------------------------------------------
# Database — preferred: single DATABASE_URL (managed hosts provide this).
# postgres:// and postgresql:// schemes are normalized to psycopg2.
# Append ?sslmode=require (or set DB_SSLMODE=require) for TLS.
#
# DATABASE_URL=postgresql://user:password@host:5432/cloudcare?sslmode=require
# -------------------------------------------------------------------------

# Fallback: individual DB_* variables (local dev without DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=cloudcare
# DB_PASSWORD=cloudcare
# DB_NAME=cloudcare

# Extra TLS control when using DB_* variables
# DB_SSLMODE=require

# Set USE_SQLITE=true ONLY for local development/tests. Ignored & forbidden
# in production.
# USE_SQLITE=true

# Connection pool tuning (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# -------------------------------------------------------------------------
# Email (password reset). With no SMTP_HOST the reset link is logged at INFO
# in development and deliberately NOT sent (WARNING, link withheld) in
# production. STARTTLS on port 587 is used.
# -------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM=CloudCare <no-reply@example.com>
# Public frontend origin used in emailed links.
# FRONTEND_URL=https://your-site.netlify.app

# -------------------------------------------------------------------------
# Optional: Patient Health Risk AI assistant. CloudCare starts without it;
# /api/health-risk/* returns 503 until this points at the folder containing
# the assistant's app/agent.py. Leave unset in normal deployments.
# -------------------------------------------------------------------------
# HEALTH_RISK_AGENT_DIR=/absolute/path/to/AI Agents

# -------------------------------------------------------------------------
# Optional: Respan tracing of the health-risk consultation workflow. Each
# /api/health-risk/chat request becomes one trace with a span per step.
# Leave RESPAN_API_KEY empty to disable tracing — the API stays fully usable
# and sends nothing. The key is server-side only; never ship it to the
# frontend. Create one at https://platform.respan.ai (Gateway > API keys).
#
# Spans record the patient record and question that were sent to the
# assistant. Add RESPAN_TRACE_CONTENT=false to keep span names, timings and
# errors while withholding those clinical payloads.
# -------------------------------------------------------------------------
RESPAN_API_KEY=
# RESPAN_TRACE_CONTENT=false
