# ---------------------------------------------------------------------------
# CloudCare API — environment template. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# development | production  (production enforces: real SECRET_KEY, Postgres,
# no /docs, no SQLite)
ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-me

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins. NEVER use "*".
# Local dev example below; set to your Netlify URL in production, e.g.
# CORS_ORIGINS=https://cloudcare.netlify.app
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Login / register rate limits (slowapi syntax). Leave the defaults in
# production; setting either to an empty string disables that limiter.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour

# -------------------------------------------------------------------------
# Database — preferred: single DATABASE_URL (managed hosts provide this).
# postgres:// and postgresql:// schemes are normalized to psycopg2.
# Append ?sslmode=require (or set DB_SSLMODE=require) for TLS.
#
# DATABASE_URL=postgresql://user:password@host:5432/cloudcare?sslmode=require
# -------------------------------------------------------------------------

# Fallback: individual DB_* variables (local dev without DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=cloudcare
# DB_PASSWORD=cloudcare
# DB_NAME=cloudcare

# Extra TLS control when using DB_* variables
# DB_SSLMODE=require

# Set USE_SQLITE=true ONLY for local development/tests. Ignored & forbidden
# in production.
# USE_SQLITE=true

# Connection pool tuning (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
